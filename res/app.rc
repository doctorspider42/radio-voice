#include <windows.h>

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1) / RT_MANIFEST (24)
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RadioVoice - microphone processor"
            VALUE "FileVersion",     "0.1.0.0"
            VALUE "InternalName",    "RadioVoice"
            VALUE "OriginalFilename","RadioVoice.exe"
            VALUE "ProductName",     "RadioVoice"
            VALUE "ProductVersion",  "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
