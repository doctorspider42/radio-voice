#include <windows.h>

#include "resource.h"
#include "rv_version.h"   // generated by CMake from the VERSION file

// CREATEPROCESS_MANIFEST_RESOURCE_ID (1) / RT_MANIFEST (24)
1 24 "app.manifest"

// Multi-resolution, from 16x16 up to 256x256; regenerate with tools/make-icon.py.
IDI_APPICON ICON "RadioVoice.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     RV_VERSION_COMMA
PRODUCTVERSION  RV_VERSION_COMMA
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RadioVoice - microphone processor"
            VALUE "FileVersion",     RV_VERSION_TEXT
            VALUE "InternalName",    "RadioVoice"
            VALUE "OriginalFilename","RadioVoice.exe"
            VALUE "ProductName",     "RadioVoice"
            VALUE "ProductVersion",  RV_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
