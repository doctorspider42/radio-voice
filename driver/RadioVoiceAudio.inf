;
; RadioVoiceAudio.inf - virtual audio cable
;
; Installs one root-enumerated device that exposes two endpoints:
;
;   "RadioVoice Output"     (playback)  - the application renders into this
;   "RadioVoice Microphone" (recording) - other applications select this
;
; There is no hardware, so the device is root-enumerated: it is created on
; demand by pnputil/devcon rather than being discovered on a bus.
;
; The reference strings under KSNAME_* must match, character for character, the
; subdevice names passed to PcRegisterSubdevice in Adapter.cpp. If they diverge,
; the driver loads and no endpoint ever appears - with no error anywhere to
; explain it.
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = MEDIA
ClassGuid   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
CatalogFile = RadioVoiceAudio.cat
; Bump this whenever the .sys changes. Windows compares the package version and
; will keep running the binary it already has if the version has not moved,
; which looks exactly like a build that did not take effect.
DriverVer   = 07/27/2026,1.0.0.2
PnpLockdown = 1

[SourceDisksNames]
222 = %DiskName%,,,""

[SourceDisksFiles]
RadioVoiceAudio.sys = 222

[DestinationDirs]
DefaultDestDir = 13   ; the driver store package directory, required by PnpLockdown

[Manufacturer]
%ProviderName% = RadioVoice, NTamd64.10.0...17763

[RadioVoice.NTamd64.10.0...17763]
%DeviceDesc% = RadioVoiceAudio, root\RadioVoiceAudio

;=============================================================================
; Install
;=============================================================================

[RadioVoiceAudio.NT]
CopyFiles = RadioVoiceAudio.CopyFiles

[RadioVoiceAudio.CopyFiles]
RadioVoiceAudio.sys

[RadioVoiceAudio.NT.Services]
AddService = RadioVoiceAudio, 0x00000002, RadioVoiceAudio.Service

[RadioVoiceAudio.Service]
DisplayName   = %ServiceName%
ServiceType   = 1   ; SERVICE_KERNEL_DRIVER
StartType     = 3   ; SERVICE_DEMAND_START - PnP starts it with the device
ErrorControl  = 1   ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\RadioVoiceAudio.sys

;=============================================================================
; Interfaces
;
; Each subdevice is registered under every KS category it belongs to. The
; categories here must agree with the Categories array in the matching
; PCFILTER_DESCRIPTOR.
;=============================================================================

[RadioVoiceAudio.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveRender%,      RadioVoice.I.WaveRender
AddInterface = %KSCATEGORY_RENDER%,   %KSNAME_WaveRender%,      RadioVoice.I.WaveRender
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveRender%,      RadioVoice.I.WaveRender
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyRender%,  RadioVoice.I.TopologyRender
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyRender%,  RadioVoice.I.TopologyRender

AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_WaveCapture%,     RadioVoice.I.WaveCapture
AddInterface = %KSCATEGORY_CAPTURE%,  %KSNAME_WaveCapture%,     RadioVoice.I.WaveCapture
AddInterface = %KSCATEGORY_REALTIME%, %KSNAME_WaveCapture%,     RadioVoice.I.WaveCapture
AddInterface = %KSCATEGORY_AUDIO%,    %KSNAME_TopologyCapture%, RadioVoice.I.TopologyCapture
AddInterface = %KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyCapture%, RadioVoice.I.TopologyCapture

[RadioVoice.I.WaveRender]
AddReg = RadioVoice.I.WaveRender.AddReg
[RadioVoice.I.WaveRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveRender.FriendlyName%

[RadioVoice.I.WaveCapture]
AddReg = RadioVoice.I.WaveCapture.AddReg
[RadioVoice.I.WaveCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveCapture.FriendlyName%

; The topology interface's FriendlyName is what the Sound control panel shows
; as the endpoint name, so these are the strings the user actually sees.
[RadioVoice.I.TopologyRender]
AddReg = RadioVoice.I.TopologyRender.AddReg
[RadioVoice.I.TopologyRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyRender.FriendlyName%

[RadioVoice.I.TopologyCapture]
AddReg = RadioVoice.I.TopologyCapture.AddReg
[RadioVoice.I.TopologyCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyCapture.FriendlyName%

;=============================================================================
; Strings
;=============================================================================

[Strings]
ProviderName = "RadioVoice"
DiskName     = "RadioVoice Driver Installation Disk"
DeviceDesc   = "RadioVoice Virtual Audio Cable"
ServiceName  = "RadioVoice Virtual Audio Cable"

; KS proxy - the standard user-mode shim that turns a KS filter into a
; DirectShow/WASAPI-visible device. Never changes.
Proxy.CLSID  = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"

KSCATEGORY_AUDIO    = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER   = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE  = "{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"

; Must match RV_WAVE_RENDER_NAME and friends in Common.h.
KSNAME_WaveRender      = "WaveRender"
KSNAME_WaveCapture     = "WaveCapture"
KSNAME_TopologyRender  = "TopologyRender"
KSNAME_TopologyCapture = "TopologyCapture"

WaveRender.FriendlyName      = "RadioVoice Output (WaveRT)"
WaveCapture.FriendlyName     = "RadioVoice Microphone (WaveRT)"
TopologyRender.FriendlyName  = "RadioVoice Output"
TopologyCapture.FriendlyName = "RadioVoice Microphone"
