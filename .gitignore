build/
build-*/
out/

# Installer output, and the driver package staged into it. Both are build
# products: the payload is copied out of driver/build by installer/stage-driver.
dist/
installer/payload/

# third_party/asiosdk IS committed - see NOTICE.md. Anything else that lands
# under third_party/ is a working copy of something fetched, and is not.
third_party/*
!third_party/asiosdk/
.vs/
.vscode/
.idea/

# WDK / MSBuild output for the driver
driver/x64/
driver/Debug/
driver/Release/
*.obj
*.pdb
*.ilk
*.exp
*.lib
*.sys
*.cat
*.user
*.aps

# Local signing material - never commit a private key
*.pfx
*.pvk
*.cer
*.p7b
